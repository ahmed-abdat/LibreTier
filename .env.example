# ImgBB API key for shareable exports
# Get your free API key at: https://api.imgbb.com/
IMGBB_API_KEY=your_api_key_here

# Upstash Redis (optional) - enables short share URLs (/share/<id>) and
# per-list OG previews (title + tier list image when shared on
# WhatsApp/Twitter/etc). Without these, sharing falls back to the long
# hash-based URL (/share#<compressed>).
#
# Create a free Redis database at https://console.upstash.com/redis or via the
# Vercel Marketplace -> Storage -> Upstash, then copy the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
